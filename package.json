{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173",
    "server": "node node_modules/tsx/dist/cli.mjs server/index.ts",
    "start": "node node_modules/tsx/dist/cli.mjs server/index.ts",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@vitejs/plugin-react": "5.1.1",
    "better-sqlite3": "^12.10.0",
    "clsx": "2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.22.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
